menu "MooBot Board"

    menu "LCD (ILI9341 SPI)"

        config MOO_PIN_LCD_SCLK
            int "SCLK GPIO"
            default 12

        config MOO_PIN_LCD_MOSI
            int "MOSI (SDI) GPIO"
            default 11

        config MOO_PIN_LCD_MISO
            int "MISO (SDO) GPIO — shared with XPT2046 touch"
            default 13

        config MOO_PIN_LCD_CS
            int "CS GPIO"
            default 10

        config MOO_PIN_LCD_DC
            int "DC GPIO"
            default 9

        config MOO_PIN_LCD_RST
            int "RST GPIO"
            default 8

        config MOO_PIN_LCD_BL
            int "Backlight GPIO (-1 = LED pin tied to 3V3, no SW control)"
            range -1 48
            default -1

        config MOO_LCD_H_RES
            int "Horizontal resolution"
            default 320

        config MOO_LCD_V_RES
            int "Vertical resolution"
            default 240

        config MOO_LCD_ILI9342_INIT
            bool "Use ILI9342C init sequence (dev-rig TPM408 panel)"
            default y
            help
                Dev-rig 320x240 landscape glass is ILI9342-class; ILI9341
                analog defaults (VCOM/gamma/power) show crosstalk lines on
                dark fields. Disable for a true ILI9341/production ST7789.

        config MOO_LCD_INVERT_COLOR
            bool "Invert panel colors"
            default n
            help
                Some clone panels need INVON. Toggle if image renders negative
                (dark UI shows white background).

        config MOO_LCD_SWAP_XY
            bool "Swap X/Y axes"
            default n

        config MOO_LCD_MIRROR_X
            bool "Mirror X"
            default n

        config MOO_LCD_MIRROR_Y
            bool "Mirror Y"
            default n

        config MOO_LCD_PCLK_MHZ
            int "SPI clock MHz"
            range 10 80
            default 20
            help
                Keep 20 on jumper wires; 40+ only on a real PCB.

    endmenu

    menu "Touch (XPT2046, demo 2+)"

        config MOO_PIN_TOUCH_CS
            int "T_CS GPIO"
            default 14

        config MOO_PIN_TOUCH_IRQ
            int "T_IRQ GPIO"
            default 21

    endmenu

    menu "Pat sensor (TTP223)"

        config MOO_PIN_PAT
            int "TTP223 OUT GPIO"
            default 6

        config MOO_PAT_COOLDOWN_MS
            int "Pat debounce/cooldown ms"
            default 400

    endmenu

    menu "LED (WS2812)"

        config MOO_PIN_WS2812
            int "WS2812 data GPIO"
            default 16

        config MOO_WS2812_COUNT
            int "LED count"
            default 4

    endmenu

    menu "Audio (I2S)"

        config MOO_PIN_I2S_AMP_BCLK
            int "MAX98357A BCLK GPIO"
            default 40

        config MOO_PIN_I2S_AMP_LRCLK
            int "MAX98357A LRCLK GPIO"
            default 41

        config MOO_PIN_I2S_AMP_DIN
            int "MAX98357A DIN GPIO"
            default 42

        config MOO_PIN_I2S_MIC_SCK
            int "ICS-43434 SCK GPIO (parked)"
            default 38

        config MOO_PIN_I2S_MIC_WS
            int "ICS-43434 WS GPIO (parked)"
            default 39

        config MOO_PIN_I2S_MIC_SD
            int "ICS-43434 SD GPIO (parked)"
            default 47

    endmenu

endmenu
