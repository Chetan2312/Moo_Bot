menu "MooBot Board"

    menu "LCD (ILI9341 SPI)"

        config MOO_PIN_LCD_SCLK
            int "SCLK GPIO"
            default 12

        config MOO_PIN_LCD_MOSI
            int "MOSI (SDI) GPIO"
            default 11

        config MOO_PIN_LCD_MISO
            int "MISO (SDO) GPIO — shared with XPT2046 touch"
            default 13

        config MOO_PIN_LCD_CS
            int "CS GPIO"
            default 10

        config MOO_PIN_LCD_DC
            int "DC GPIO"
            default 9

        config MOO_PIN_LCD_RST
            int "RST GPIO"
            default 8

        config MOO_PIN_LCD_BL
            int "Backlight GPIO (-1 = LED pin tied to 3V3, no SW control)"
            range -1 48
            default -1

        config MOO_LCD_H_RES
            int "Horizontal resolution"
            default 320

        config MOO_LCD_V_RES
            int "Vertical resolution"
            default 240

        config MOO_LCD_ILI9342_INIT
            bool "Use ILI9342C init sequence (dev-rig TPM408 panel)"
            default y
            help
                Dev-rig 320x240 landscape glass is ILI9342-class; ILI9341
                analog defaults (VCOM/gamma/power) show crosstalk lines on
                dark fields. Disable for a true ILI9341/production ST7789.

        config MOO_LCD_INVERT_COLOR
            bool "Invert panel colors"
            default y if MOO_LCD_ILI9342_INIT
            default n
            help
                ILI9342-class glass expects INVON. Toggle if image renders
                negative (dark UI shows white background).

        config MOO_LCD_SWAP_XY
            bool "Swap X/Y axes"
            default n

        config MOO_LCD_MIRROR_X
            bool "Mirror X"
            default n

        config MOO_LCD_MIRROR_Y
            bool "Mirror Y"
            default n

        config MOO_LCD_PCLK_MHZ
            int "SPI clock MHz"
            range 10 80
            default 20
            help
                Keep 20 on jumper wires; 40+ only on a real PCB.

    endmenu

    menu "Touch (XPT2046)"

        config MOO_PIN_TOUCH_CS
            int "T_CS GPIO"
            default 14

        config MOO_PIN_TOUCH_IRQ
            int "T_IRQ GPIO (-1 if unwired)"
            range -1 48
            default 21

        config MOO_TOUCH_SWAP_XY
            bool "Swap touch X/Y (match landscape panel)"
            default y

        config MOO_TOUCH_MIRROR_X
            bool "Mirror touch X"
            default y

        config MOO_TOUCH_MIRROR_Y
            bool "Mirror touch Y"
            default n

    endmenu

    menu "RTC (DS3231, I2C)"

        config MOO_PIN_I2C_SDA
            int "I2C SDA GPIO"
            default 4

        config MOO_PIN_I2C_SCL
            int "I2C SCL GPIO"
            default 5

    endmenu

    menu "Pat sensor (TTP223)"

        config MOO_PIN_PAT
            int "TTP223 OUT GPIO"
            default 6

        config MOO_PAT_COOLDOWN_MS
            int "Pat contact-debounce ms (small! gesture grouping is in main)"
            default 60
            help
                Only rejects contact bounce between distinct taps. Must stay
                small (<100) or rapid multi-taps get dropped before the
                gesture task can count them.

    endmenu

    menu "LED (WS2812)"

        config MOO_PIN_WS2812
            int "WS2812 data GPIO"
            default 16

        config MOO_WS2812_COUNT
            int "LED count"
            default 4

    endmenu

    menu "Audio out"

        choice MOO_AUDIO_BACKEND
            prompt "Output backend"
            default MOO_AUDIO_BACKEND_LEDC
            help
                I2S drives a MAX98357A-class DAC+amp: true 16-bit PCM over
                three wires. Cleanest output, needs the amp board.

                PDM drives the same single-wire analog speaker module as
                LEDC, but through the S3's hardware sigma-delta modulator:
                real 16-bit PCM on ONE pin, so WAV/voice plays without any
                new hardware. Put an RC low-pass on SIGNAL (1 kOhm + 10 nF,
                ~16 kHz) — the raw PDM carrier is in the MHz.

                LEDC drives that module with a PWM carrier: square-wave
                tones only. The ESP32-S3 has no DAC, so PWM was the only
                analog-ish option before PDM. Melodies sound identical in
                pitch and timing; timbre is harsher and there is no PCM
                path. Kept as the fallback if PDM misbehaves.

            config MOO_AUDIO_BACKEND_I2S
                bool "I2S DAC + amp (MAX98357A)"

            config MOO_AUDIO_BACKEND_PDM
                bool "PDM sigma-delta into analog speaker module"

            config MOO_AUDIO_BACKEND_LEDC
                bool "LEDC PWM into analog speaker module (tones only)"
        endchoice

        config MOO_PIN_SPEAKER_PWM
            int "Speaker module SIGNAL GPIO"
            depends on MOO_AUDIO_BACKEND_LEDC || MOO_AUDIO_BACKEND_PDM
            default 7
            help
                Same wire for both single-pin backends: LEDC drives it with
                a PWM carrier, PDM with a sigma-delta bitstream.

                Deliberately not 15 — that keeps 15/17/18 contiguous for a
                1-bit SDMMC card slot later.

        config MOO_PIN_I2S_AMP_BCLK
            int "MAX98357A BCLK GPIO"
            depends on MOO_AUDIO_BACKEND_I2S
            default 40

        config MOO_PIN_I2S_AMP_LRCLK
            int "MAX98357A LRCLK GPIO"
            depends on MOO_AUDIO_BACKEND_I2S
            default 41

        config MOO_PIN_I2S_AMP_DIN
            int "MAX98357A DIN GPIO"
            depends on MOO_AUDIO_BACKEND_I2S
            default 42

    endmenu

    menu "Microphone (INMP441, I2S)"

        config MOO_MIC_ENABLE
            bool "Enable INMP441 microphone"
            default y

        config MOO_PIN_I2S_MIC_SCK
            int "INMP441 SCK GPIO"
            depends on MOO_MIC_ENABLE
            default 38

        config MOO_PIN_I2S_MIC_WS
            int "INMP441 WS GPIO"
            depends on MOO_MIC_ENABLE
            default 39

        config MOO_PIN_I2S_MIC_SD
            int "INMP441 SD GPIO"
            depends on MOO_MIC_ENABLE
            default 47

        config MOO_MIC_SAMPLE_RATE
            int "Sample rate (Hz)"
            depends on MOO_MIC_ENABLE
            default 16000
            help
                16 kHz is what every on-device wake-word / command engine
                wants. Raise only if you need >8 kHz of audio bandwidth.

        config MOO_MIC_SLOT_RIGHT
            bool "Mic on RIGHT I2S slot (L/R tied to VDD)"
            depends on MOO_MIC_ENABLE
            default n
            help
                INMP441 L/R tied to GND -> data in the LEFT slot; leave this
                n. Tied to VDD -> RIGHT slot. If the level monitor reports a
                dead -90 dBFS, flip this before suspecting the wiring.

        config MOO_MIC_GAIN_SHIFT
            int "Digital gain (left-shift bits)"
            depends on MOO_MIC_ENABLE
            range 0 12
            default 4
            help
                Sensitivity is -26 dBFS @ 94 dB SPL, so desk-level speech
                lands near -55 dBFS and looks like silence in raw int16.
                Each bit is +6 dB; 4 = +24 dB. Too much clips — watch the
                peak figure in the monitor log.

        config MOO_MIC_VAD_MARGIN_DB
            int "Voice detect margin above the noise floor (dB)"
            depends on MOO_MIC_ENABLE
            range 4 30
            default 10
            help
                audio_in_record() measures the room's noise floor, then
                treats anything this far above it as speech. Too low and a
                fan starts recordings; too high and quiet speech is missed.

        config MOO_MIC_MONITOR
            bool "Start the bringup level-monitor task"
            depends on MOO_MIC_ENABLE
            default y
            help
                Logs RMS dBFS and peak every ~200 ms. Turn off once the mic
                is verified.

    endmenu

endmenu
